{
  "name": "shamir-secret",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite src",
    "build": "node scripts/build.js",
    "preview": "vite preview dist",
    "test": "node --test",
    "lint": "npm run lint:js && npm run lint:css && npm run format:check",
    "lint:js": "eslint . --max-warnings=0",
    "lint:css": "stylelint \"src/**/*.css\" --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm test && npm run build",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.1",
    "fast-check": "^4.7.0",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "stylelint": "^17.9.0",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^8.0.10"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,css,html,json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.{js,mjs,cjs}": [
      "eslint --max-warnings=0"
    ],
    "*.css": [
      "stylelint --max-warnings=0"
    ]
  },
  "dependencies": {
    "@scure/base": "2.2.0"
  }
}
